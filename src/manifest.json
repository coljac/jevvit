{
  "manifest_version": 3,
  "name": "Jevvit",
  "version": "0.1.0",
  "description": "Filter Reddit with Jev, a fast and cheap AI. You write the prompt; Jevvit collapses, hides or dims the stories that match.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Jevvit",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*", "*://*.reddit.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["lib/core.js", "content/reddit.js"],
      "css": ["content/reddit.css"],
      "run_at": "document_start"
    }
  ]
}
